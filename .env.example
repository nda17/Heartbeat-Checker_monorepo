# Reference only: neither the API nor Make executes or loads this file.
# These credentials and disabled TLS are for the loopback-only local database.
DATABASE_URL=postgres://heartbeat_local:heartbeat_local_only@127.0.0.1:55432/heartbeat_local?sslmode=disable
APP_ENV=local
HTTP_ADDR=127.0.0.1:8080
DATABASE_TIMEOUT=5s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=720h
AUTH_CHALLENGE_TTL=30m
AUTH_RESET_TTL=30m
AUTH_RATE_LIMIT_WINDOW=1h

# Official Cloudflare public test keys; local mode still calls Siteverify.
TURNSTILE_LOCAL_TEST_MODE=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAME=localhost

# Local Mailpit capture only: http://127.0.0.1:58025
SMTP_ADDR=127.0.0.1:51025
SMTP_FROM=no-reply@heartbeat.local
# Production API does not use SMTP. Production worker requires SMTP_ADDR,
# SMTP_FROM, SMTP_USERNAME, SMTP_PASSWORD and SMTP_TLS_MODE=implicit_tls|starttls.
# It validates the SMTP certificate and authenticates only after TLS.
# Both production API and worker need the same separate 32-byte base64 key;
# preserve it with database backups so pending encrypted auth mail can recover.
# AUTH_MAIL_ENCRYPTION_KEY=
# Dedicated 32-byte base64 key for admin MFA factors, API and encrypted backup
# only. Keep the original value with the database; never rotate it in place.
AUTH_MFA_ENCRYPTION_KEY=
# Production API accepts X-Heartbeat-Client-IP only from these proxy CIDRs.
# TRUSTED_PROXY_CIDRS=172.30.64.2/32

# Isolated probe. make init-local generates a random secret in .local/probe-secret.
# The worker and probe need the same value; never expose it to the frontend.
PROBE_URL=http://127.0.0.1:8090
PROBE_HTTP_ADDR=127.0.0.1:8090
PROBE_SHARED_SECRET=

# API and worker only. Generate with make init-local for local development.
# Do not pass this key to the probe or frontend.
WEBHOOK_ENCRYPTION_KEY=

# Optional native support relay. API and worker share the encryption key and
# routing IDs; API receives webhook secrets, worker receives bot tokens.
# Support and Informer bots are separate. Never commit real IDs or tokens.
SUPPORT_ENABLED=false
SUPPORT_ENCRYPTION_KEY=
TELEGRAM_BOT_SUPPORT_TOKEN=
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
MAX_BOT_SUPPORT_TOKEN=
MAX_SUPPORT_WEBHOOK_SECRET=
TELEGRAM_INTERNAL_CHAT_ID=
TELEGRAM_SUPPORT_TOPIC_ID=
# Zero permits discovery but disables MAX delivery; never binds a group automatically.
MAX_SUPPORT_CHAT_ID=0
# Optional PEM trust anchor for the official MAX endpoint, scoped to its transport.
SUPPORT_MAX_ROOT_CA_FILE=
# Official API by default; the reviewed production relay is also supported.
# https://messengers-proxy.heartbeat-checker.ru/telegram-api
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Optional public literal destination IP; TLS verifies the configured URL host.
TELEGRAM_API_PROXY_IP=

# Mock checkout never charges money. An empty allowlist denies quota simulation.
# Supply UUIDs of explicitly authorized, verified accounts, separated by commas.
BILLING_PROVIDER=disabled
BILLING_MOCK_ACCOUNT_IDS=
BILLING_REPORTS_ENABLED=false
TELEGRAM_BOT_INFORMER_TOKEN=
TELEGRAM_PAYMENTS_TOPIC_ID=
TELEGRAM_BACKUPS_TOPIC_ID=

# Optional incident notifications. API receives webhook secrets and public bot
# links; worker receives bot tokens and public links. Reuse the encryption key.
# Keep TELEGRAM_BOT_INFORMER_TOKEN stable: payment reports and backup use it too.
MESSENGER_NOTIFICATIONS_ENABLED=false
TELEGRAM_INFORMER_WEBHOOK_SECRET=
MAX_INFORMER_WEBHOOK_SECRET=
MAX_BOT_INFORMER_TOKEN=
TELEGRAM_INFORMER_BOT_USERNAME=
MAX_INFORMER_BOT_URL=

# Backup job only. Never pass S3 credentials or the recovery identity to the app.
# The VPS receives the public age recipient; keep its private identity offline.
# .backup.env contains these S3/age settings and the three Informer routing fields;
# database URL, app encryption keys and Telegram API routing come from canonical .env.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
