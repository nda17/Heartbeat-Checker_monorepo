# Reference only: neither the API nor Make executes or loads this file.
# These credentials and disabled TLS are for the loopback-only local database.
DATABASE_URL=postgres://heartbeat_local:heartbeat_local_only@127.0.0.1:55432/heartbeat_local?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DATABASE_TIMEOUT=5s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

AUTH_ORIGIN=http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL=720h
AUTH_CHALLENGE_TTL=30m
AUTH_RESET_TTL=30m
AUTH_RATE_LIMIT_WINDOW=1h

# Official Cloudflare public test keys; local mode still calls Siteverify.
TURNSTILE_LOCAL_TEST_MODE=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAME=localhost

# Local Mailpit capture only: http://127.0.0.1:58025
SMTP_ADDR=127.0.0.1:51025
SMTP_FROM=no-reply@heartbeat.local
