{
  "name": "@heartbeat/web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app src scripts *.ts *.json *.mjs",
    "format:check": "prettier --check app src scripts *.ts *.json *.mjs",
    "test:ui": "node --test scripts/admin-ui.test.mjs scripts/account-deletion.test.mjs scripts/android-download.test.mjs scripts/android-push-ui.test.mjs scripts/auth-entry.test.mjs scripts/messenger-email.test.mjs scripts/monitors-pagination.test.mjs scripts/pricing.test.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
