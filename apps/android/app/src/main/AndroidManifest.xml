<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="com.huawei.hwid" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <application
        android:name=".HeartbeatApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_messaging_notification_delegation_enabled" android:value="false" />
        <meta-data android:name="push_kit_auto_init_enabled" android:value="false" />
        <meta-data android:name="com.huawei.hms.client.bi.setting" android:value="true" />
        <meta-data android:name="com.huawei.hms.client.bireport.setting" android:value="false" />
        <provider android:name="com.huawei.hms.aaid.InitProvider" tools:node="remove" />
        <provider android:name="com.huawei.agconnect.core.provider.AGConnectInitializeProvider" tools:node="remove" />
        <receiver android:name="com.huawei.hms.support.api.push.PushMsgReceiver" android:enabled="${huaweiEnabled}" tools:replace="android:enabled" />
        <receiver android:name="com.huawei.hms.support.api.push.PushReceiver" android:enabled="${huaweiEnabled}" tools:replace="android:enabled" />
        <service android:name="com.huawei.hms.support.api.push.service.HmsMsgService" android:enabled="${huaweiEnabled}" tools:replace="android:enabled" />
        <provider android:name="com.huawei.hms.support.api.push.PushProvider"
            android:enabled="${huaweiEnabled}" android:exported="true"
            android:readPermission="${applicationId}.permission.PUSH_PROVIDER"
            android:writePermission="${applicationId}.permission.PUSH_WRITE_PROVIDER"
            tools:replace="android:enabled" />
        <meta-data android:name="com.huawei.hms.client.appid" android:value="${huaweiAppId}" />
        <meta-data android:name="com.heartbeatchecker.push.huawei.enabled" android:value="${huaweiEnabled}" />
        <meta-data android:name="com.heartbeatchecker.push.huawei.app_id" android:value="id=${huaweiPublicAppId}" />
        <meta-data android:name="com.heartbeatchecker.push.huawei.project_id" android:value="id=${huaweiProjectId}" />
        <meta-data android:name="com.heartbeatchecker.push.huawei.cp_id" android:value="id=${huaweiCpId}" />
        <service android:name=".HuaweiPushService" android:enabled="${huaweiEnabled}" android:exported="false">
            <intent-filter><action android:name="com.huawei.push.action.MESSAGING_EVENT" /></intent-filter>
        </service>
        <service android:name=".FirebasePushService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <meta-data android:name="ru.rustore.sdk.pushclient.default_notification_icon" android:resource="@drawable/ic_notification" />
        <meta-data android:name="ru.rustore.sdk.pushclient.default_notification_channel_id" android:value="incidents" />
        <service android:name=".HeartbeatMessagingService" android:exported="true" tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="ru.rustore.sdk.pushclient.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${appLinkHost}" />
                <data android:path="/app" />
                <data android:path="/app/settings" />
                <data android:path="/app/billing" />
                <data android:path="/android/auth/complete" />
                <data android:path="/android/auth/reset" />
                <data android:path="/android/auth/verify" />
                <data android:path="/android/payments/return" />
            </intent-filter>
        </activity>
    </application>
</manifest>
